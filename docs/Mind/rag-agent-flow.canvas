		{"id":"builder-repair","fromNode":"builder","fromSide":"bottom","toNode":"repair","toSide":"top","label":""},
		{"id":"decide-query","fromNode":"decide","fromSide":"right","toNode":"query","toSide":"left","label":"开启"},
		{"id":"decide-builder","fromNode":"decide","fromSide":"bottom","toNode":"builder","toSide":"top","label":"关闭"},
		{"id":"worker-builder","fromNode":"worker","fromSide":"left","toNode":"builder","toSide":"right","label":"参考原文与来源"},
		{"id":"builder-evidence","fromNode":"builder","fromSide":"right","toNode":"evidence","toSide":"left","label":"实际注入证据"},
		{"id":"repair-validate","fromNode":"repair","fromSide":"left","toNode":"validate","toSide":"left","label":"重新验证"},
